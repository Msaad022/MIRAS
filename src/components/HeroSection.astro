<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <img
    id="hero-poster"
    src="/MIRAS/videos/poster-frame.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover z-[1] transition-opacity duration-1000"
  />
  <video
    id="hero-video"
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
  >
    <source src="/MIRAS/videos/hero.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/60 z-[2]"></div>
  <div
    class="relative z-10 text-center text-white px-4 sm:px-6 max-w-3xl mx-auto z-[3]"
  >
    <img
      src="/MIRAS/images/logo.png"
      alt="مِراس | MIRAS"
      class="w-30 h-30 sm:w-48 sm:h-48 mx-auto mb-4 sm:mb-6 object-cover"
    />
    <h1
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight"
    >
      أبواب وشبابيك بجودة أوروبية وصناعة مصرية
    </h1>
    <p
      class="text-base sm:text-lg md:text-xl mb-6 sm:mb-8 text-gray-200 max-w-xl mx-auto"
    >
      ألومنيوم · خشب طبيعي · حديد مشغول · واجهات زجاجية — تصنيع وتركيب بضمان حتى
      ١٠ سنوات
    </p>
    <a
      href="#contact"
      class="inline-block bg-accent hover:bg-accent-light text-white px-6 sm:px-8 py-3 rounded-lg text-base sm:text-lg font-semibold transition-colors"
    >
      احجز معاينة مجانية
    </a>
  </div>
</section>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement;
  const poster = document.getElementById("hero-poster") as HTMLImageElement;

  function reveal() {
    video.style.opacity = "1";
    poster.style.opacity = "0";
    poster.addEventListener("transitionend", () => poster.remove(), {
      once: true,
    });
  }

  if (video.readyState >= 3) {
    reveal();
  } else {
    video.addEventListener("canplay", reveal, { once: true });
  }
</script>
