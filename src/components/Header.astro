<header
  class="fixed top-0 inset-x-0 z-50 bg-white/90 dark:bg-gray-950/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800"
>
  <nav
    class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-3"
    aria-label="التنقل الرئيسي"
  >
    <a href="#hero" class="font-bold text-lg text-accent shrink-0"
      >مِراس | MIRAS</a
    >

    <ul class="hidden md:flex items-center gap-4 lg:gap-6 text-sm font-medium">
      <li>
        <a href="#hero" class="hover:text-accent transition-colors">الرئيسية</a>
      </li>
      <li>
        <a href="#vision" class="hover:text-accent transition-colors">رؤيتنا</a>
      </li>
      <li>
        <a href="#work" class="hover:text-accent transition-colors">أعمالنا</a>
      </li>
      <li>
        <a href="#process" class="hover:text-accent transition-colors"
          >خطواتنا</a>
      </li>
      <li>
        <a href="#contact" class="hover:text-accent transition-colors"
          >تواصل معنا</a>
      </li>
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="hidden md:inline-block bg-accent hover:bg-accent-light text-white px-5 py-2 rounded-lg text-sm font-semibold transition-colors"
      >
        احجز معاينة مجانية
      </a>
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-700 dark:text-gray-300"
        aria-label="فتح القائمة"
        aria-expanded="false"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 px-4 sm:px-6 pb-4"
  >
    <ul class="flex flex-col gap-3 text-sm font-medium">
      <li><a href="#hero" class="block py-2 hover:text-accent">الرئيسية</a></li>
      <li><a href="#vision" class="block py-2 hover:text-accent">رؤيتنا</a></li>
      <li><a href="#work" class="block py-2 hover:text-accent">أعمالنا</a></li>
      <li>
        <a href="#process" class="block py-2 hover:text-accent">خطواتنا</a>
      </li>
      <li>
        <a href="#contact" class="block py-2 hover:text-accent">تواصل معنا</a>
      </li>
      <li>
        <a
          href="#contact"
          class="block bg-accent text-white text-center px-4 py-2.5 rounded-lg mt-1 font-semibold"
          >احجز معاينة مجانية</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
